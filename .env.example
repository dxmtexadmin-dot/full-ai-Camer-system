# ============================================================================
#  AI CCTV - Xodimlarni tanish va jihozlar inventarizatsiyasi
#  Copy this file to ".env" and edit the values.  NEVER commit the real .env.
# ============================================================================

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Tashkent

# --- Database ---------------------------------------------------------------
# SQLite for now. The models only use portable SQLAlchemy types, so switching to
# PostgreSQL later is a matter of changing this URL and installing a driver, e.g.
# DATABASE_URL=postgresql+psycopg://user:secret@localhost:5432/inventory
DATABASE_URL=sqlite:///./data/inventory.db

# --- Security ---------------------------------------------------------------
# Generate with: py -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-please-use-a-long-random-string
SESSION_MAX_AGE_SECONDS=43200
# Bootstrap administrator, created only when the users table is empty.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_FULLNAME=Tizim administratori

# --- Object detection (YOLO) -------------------------------------------------
# Use the custom-trained workplace model. Falls back to yolov8s.pt if the file
# is missing, so the pipeline can still be smoke-tested.
YOLO_MODEL_PATH=data/models/equipment_best.pt
YOLO_FALLBACK_MODEL=yolov8s.pt
YOLO_CONFIDENCE=0.35
YOLO_IMAGE_SIZE=640
# cpu | cuda:0
YOLO_DEVICE=cpu
# ByteTrack config shipped with ultralytics
YOLO_TRACKER=bytetrack.yaml
# One object reported under two labels (tv + monitor) keeps only the most
# confident box. 0.6 is the recommended value.
YOLO_DEDUPE_IOU=0.6

# --- Face recognition (InsightFace + ONNX Runtime) ---------------------------
FACE_MODEL_NAME=buffalo_l
FACE_SIMILARITY_THRESHOLD=0.45
# A match is rejected when the best and the second-best employee are closer than
# this margin - prevents "guessing" between look-alike enrollments.
FACE_MATCH_MARGIN=0.05
FACE_PROVIDERS=CPUExecutionProvider
FACE_DETECTION_SIZE=640x640
# Run recognition on every Nth processed frame per person track
FACE_RECOGNITION_INTERVAL=10

# --- Camera processing -------------------------------------------------------
CAMERA_RECONNECT_INTERVAL=5
CAMERA_MAX_RETRY_INTERVAL=60
PROCESSING_FPS=10
PROCESSING_WIDTH=1280
PROCESSING_HEIGHT=720
MAX_FRAME_QUEUE=4
# Set to true to run the pipeline on a synthetic source (no real camera needed)
SIMULATION_MODE=false

# --- Events / evidence -------------------------------------------------------
EVENT_COOLDOWN_SECONDS=20
EVIDENCE_ENABLED=true
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_JPEG_QUALITY=85

# --- Google Sheets -----------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SPREADSHEET_ID=
# Path to the service-account JSON, e.g. ./secrets/service_account.json
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=120
GOOGLE_SHEETS_MAX_RETRIES=4

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
